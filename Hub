local function toggle(parent, text, key, cb)
	local r = mk("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = C.row }, parent)
	round(r, 4)
	mk("TextLabel", { Size = UDim2.new(1, -50, 1, 0), Position = UDim2.fromOffset(8, 0), BackgroundTransparency = 1, Text = text, TextColor3 = C.txt, TextSize = 11, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left }, r)
	local sw = mk("TextButton", { Size = UDim2.fromOffset(34, 18), Position = UDim2.new(1, -42, 0.5, -9), BackgroundColor3 = C.bg, Text = "", AutoButtonColor = false }, r)
	round(sw, 9)
	local kn = mk("Frame", { Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = C.dim }, sw)
	round(kn, 7)
	sw.MouseButton1Click:Connect(function()
		F[key] = not F[key]
		TweenService:Create(sw, TweenInfo.new(0.12), { BackgroundColor3 = F[key] and C.acc or C.bg }):Play()
		TweenService:Create(kn, TweenInfo.new(0.12), {
			Position = F[key] and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2),
			BackgroundColor3 = F[key] and Color3.new(1, 1, 1) or C.dim
		}):Play()
		if cb then pcall(cb, F[key]) end
	end)
end

local function slider(parent, text, key, min, max, cb)
	local r = mk("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = C.row }, parent)
	round(r, 4)
	local l = mk("TextLabel", { Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(8, 2), BackgroundTransparency = 1, Text = text .. ": " .. F[key], TextColor3 = C.txt, TextSize = 11, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left }, r)
	local tr = mk("TextButton", { Size = UDim2.new(1, -16, 0, 5), Position = UDim2.fromOffset(8, 24), BackgroundColor3 = C.bg, Text = "", AutoButtonColor = false }, r)
	round(tr, 3)
	local fl = mk("Frame", { Size = UDim2.new((F[key] - min) / (max - min), 0, 1, 0), BackgroundColor3 = C.acc }, tr)
	round(fl, 3)
	local hold = false
	local function set(x)
		local a = math.clamp((x - tr.AbsolutePosition.X) / tr.AbsoluteSize.X, 0, 1)
		local v = math.floor(min + a * (max - min) + 0.5)
		F[key] = v
		fl.Size = UDim2.new(a, 0, 1, 0)
		l.Text = text .. ": " .. v
		if cb then pcall(cb, v) end
	end
	tr.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			hold = true
			set(i.Position.X)
		end
	end)
	on(UIS.InputChanged, function(i)
		if hold then set(i.Position.X) end
	end)
	on(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then hold = false end
	end)
end

local function button(parent, text, cb)
	local b = mk("TextButton", { Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = C.row, Text = text, TextColor3 = C.txt, TextSize = 11, Font = Enum.Font.GothamMedium, AutoButtonColor = false }, parent)
	round(b, 4)
	b.MouseButton1Click:Connect(function() pcall(cb) end)
end

