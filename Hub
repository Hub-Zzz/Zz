----------------------------- aimbot
local function target()
	local best, score = nil, math.huge
	local c = Cam.ViewportSize
	local center = Vector2.new(c.X / 2, c.Y / 2)
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LP and p.Character then
			local h = p.Character:FindFirstChildWhichIsA("Humanoid")
			local root = p.Character:FindFirstChild("HumanoidRootPart")
			if h and root and h.Health > 0 then
				local sameTeam = F.Team and LP.Team and p.Team == LP.Team
				if not sameTeam then
					local ok = true
					if F.Wall then
						local rp = RaycastParams.new()
						rp.FilterType = Enum.RaycastFilterType.Exclude
						rp.FilterDescendantsInstances = { LP.Character, p.Character }
						ok = not workspace:Raycast(Cam.CFrame.Position, root.Position - Cam.CFrame.Position, rp)
					end
					if ok then
						local sp, vis = Cam:WorldToViewportPoint(root.Position)
						if vis and sp.Z > 0 then
							local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
							if d <= F.FOV and d < score then
								best, score = root, d
							end
						end
					end
				end
			end
		end
	end
	return best
end

local function aimAt(root)
	local sp, vis = Cam:WorldToViewportPoint(root.Position)
	if not vis then return end
	local c = Cam.ViewportSize
	local delta = Vector2.new(sp.X, sp.Y) - Vector2.new(c.X / 2, c.Y / 2)
	local a = F.Smooth / 100
	if mousemoverel then
		mousemoverel(delta.X * a, delta.Y * a)
	else
		Cam.CFrame = Cam.CFrame:Lerp(CFrame.lookAt(Cam.CFrame.Position, root.Position), a)
	end
end

on(RunService.RenderStepped, function()
	fovCircle.Visible = F.Aimbot
