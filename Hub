local function page(name)
	local b = mk("TextButton", { Size = UDim2.fromOffset(64, 22), BackgroundColor3 = C.row, Text = name, TextColor3 = C.dim, TextSize = 11, Font = Enum.Font.GothamMedium, AutoButtonColor = false }, tabs)
